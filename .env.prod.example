# =============================================================================
# SANAD Production Environment — COMPLETE REFERENCE
# Copy to .env and fill real values. NEVER commit .env itself.
# =============================================================================

# --- SANAD service ---
# Public base URL of SANAD as seen by the LMS (server-to-server).
# Example: http://sanad-api:8000 (docker network) or https://sanad.example.com
SANAD_BASE_URL=http://localhost:8000

# API key(s) the LMS sends as X-API-Key. Comma-separated for rotation.
# Generate: openssl rand -hex 32
SANAD_API_KEYS=demo-key-123
SANAD_TIMEOUT=60

# Tenant sent by LMS in every /evaluate/submission request.
SANAD_TENANT_ID=demo_tenant

# --- SANAD internals ---
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=hash-dev
# EMBEDDING_MODEL=multilingual-e5   # production (needs HF download once)
# EMBEDDING_MODEL=bge-m3            # alternative multilingual

# LLM provider — set ONE for real grading (priority: ANTHROPIC > GEMINI > fake)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Rate limiting / CORS ---
SANAD_RATE_LIMIT=60
SANAD_RATE_BURST=10
# SANAD_CORS_ORIGINS=https://lms.example.com

# --- Frontend (user-facing UI) ---
# Public API URL baked into the frontend build (browser -> nginx -> api).
FRONTEND_API_URL=http://localhost:8000
# Demo-only key baked into the frontend build. Production: keep keys server-side.
FRONTEND_API_KEY=demo-key-123

# --- App ---
LOG_LEVEL=INFO
PYTHONPATH=/app

# --- LMS worker (Express example) ---
# REDIS_URL=redis://localhost:6379
# PORT=3000

# --- Optional monitoring ---
# SENTRY_DSN=
# METRICS_PORT=9090
# HF_TOKEN=   # to avoid HF Hub rate limits for embeddings/reranker downloads
