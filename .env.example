# Copy this file to .env and fill in real values. Never commit .env itself.

# =============================================================================
# Vector Store
# =============================================================================
# Leave unset or "local" for on-disk embedded Qdrant (dev/test).
# Set to a real URL (e.g. http://localhost:6333) to use the Dockerized service.
QDRANT_URL=local

# =============================================================================
# Embedding Backend
# =============================================================================
# "hash-dev" (default, no network/model needed) or
# "multilingual-e5" (requires network access to download the model once).
# "bge-m3" (BAAI/bge-m3, better multilingual support)
EMBEDDING_MODEL=hash-dev

# =============================================================================
# LLM Backend
# =============================================================================
# Only needed for real generation (Phase 5). Without this, the API falls
# back to FakeLLM (dev-only, extracts the top retrieved chunk verbatim —
# not real generation, just enough to exercise the pipeline).
ANTHROPIC_API_KEY=

# Google Gemini API (Free tier at https://aistudio.google.com/apikey)
# New keys start with AQ. / old keys start with AIzaSy — both work with google-genai SDK.
GEMINI_API_KEY=

# Per-call timeout for Gemini requests (seconds). On expiry the query
# pipeline falls back to FakeLLM instead of hanging the request.
GEMINI_TIMEOUT_S=45

# Only needed if using the OpenAI embedding comparison arm.
OPENAI_API_KEY=

# =============================================================================
# Security (Phase 9)
# =============================================================================
# API Keys for authentication (comma-separated).
# If not set, API runs in dev mode (no authentication required).
# Generate with: openssl rand -hex 32
SANAD_API_KEYS=

# Rate limiting (requests per minute per IP)
SANAD_RATE_LIMIT=60
SANAD_RATE_BURST=10

# CORS origins (comma-separated)
# SANAD_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# =============================================================================
# Production Deployment
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Python path
PYTHONPATH=/app

# =============================================================================
# Optional: Monitoring
# =============================================================================
# Sentry DSN for error tracking
# SENTRY_DSN=

# Prometheus metrics port (if enabled)
# METRICS_PORT=9090